rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // One folder per user, matching the users/{uid} collection in Firestore.
    // Public read so an avatar renders anywhere it's shown.
    match /users/{uid}/avatar {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Saved clips and their stills. Deliberately NOT under users/{uid}/ so the
    // bucket's 30-day lifecycle rule can match this prefix alone and never
    // sweep away profile photos. Private to the owner — these are personal
    // videos, not avatars.
    match /generations/{uid}/{generationId}/{fileName} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 100 * 1024 * 1024
                   && (request.resource.contentType.matches('video/.*')
                       || request.resource.contentType.matches('image/.*'));
    }
  }
}
