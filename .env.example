# Obligatoria: la selección de los mejores momentos se hace con IA.
# Sin esta clave, /api/analyze devuelve 503 y la app muestra un error.
OPENAI_API_KEY=
# Puedes escoger otro modelo con entrada de imagen (visión).
OPENAI_MODEL=gpt-5.6-luna

# Firebase (Auth) — copia estos valores desde Firebase Console > Configuración
# del proyecto > tus apps > app Web > "Config" del SDK. Son claves públicas
# (no secretas), seguras para exponer en el cliente.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
